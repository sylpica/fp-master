     }
    ]
   },
   "lawBaseDate": "2026-04-01",
   "stem": "家計の収支構造の説明として、誤っているものはどれか。",
   "parts": [
    {
     "kind": "choice",
     "id": "p1",
     "choices": [
      {
       "id": "1",
       "text": "変動費は、家賃や通信費といった毎月ほぼ一定額で発生する費用をいう。"
      },
      {
       "id": "2",
       "text": "固定費は、家賃やスマホ代といった毎月発生する一定額の費用をいう。"
      },
      {
       "id": "3",
       "text": "手取り収入を確認する際は、総支給額ではなく、社会保険料や税金が差し引かれた後の額を見る。"
      }
     ],
     "answer": "1"
    }
   ],
   "requiresCalculation": false,
