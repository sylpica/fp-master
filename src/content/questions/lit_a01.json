  {
   "id": "lit-a01-04",
   "exam": "lit",
   "field": "A",
   "theme": "3大支出への備え方",
   "source": {
    "kind": "original",
    "author": "FP Master（金融リテラシー検定の出題範囲に基づくオリジナル問題）",
    "basis": [
     {
      "title": "政府広報オンライン お金の勉強をしませんか？社会人として知っておきたいお金の話",
      "url": "https://www.gov-online.go.jp/article/202412/entry-6812.html"
     }
    ]
   },
   "lawBaseDate": "2026-04-01",
   "stem": "人生の3大支出への備え方として、最も適切なものはどれか。",
   "parts": [
    {
     "kind": "choice",
     "id": "p1",
     "choices": [
      {
       "id": "1",
       "text": "老後資金は、3大支出に含まれないため、現役時代に準備する必要はない。"
      },
      {
       "id": "2",
       "text": "教育費は、子どもの成長とともにお金のかかる時期がはっきりとしているため、早めに貯め始める。"
      },
      {
       "id": "3",
       "text": "住宅購入では、頭金が準備できなくても物件価格の全額をローンで借りるのが安全である。"
      }
     ],
     "answer": "2"
    }
   ],
   "requiresCalculation": false,
   "status": "verified",
   "level": 2,
   "topic": "A1-1"
  },
